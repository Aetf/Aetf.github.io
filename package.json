{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "hexo": {
    "version": "8.1.2"
  },
  "scripts": {
    "stable-upd-time": "tools/stable_update_time.sh",
    "clean": "hexo clean --silent",
    "prebuild": "npm run stable-upd-time",
    "build": "hexo generate",
    "serve": "hexo server",
    "prestart": "npm run clean && npm run stable-upd-time",
    "start": "npm run serve -- --watch",
    "deploy": "hexo deploy",
    "test": "ava"
  },
  "overrides": {
    "hexo-filter-responsive-images": {
      "hexo": "$hexo"
    }
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-clean-css": "^2.0.0",
    "hexo-deployer-rsync": "^3.0.0",
    "hexo-excerpt": "^1.1.6",
    "hexo-filter-responsive-images": "^1.7.0",
    "hexo-fs": "^5.0.1",
    "hexo-generator-alias": "^1.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.3.3",
    "hexo-generator-tag": "^2.0.0",
    "hexo-next-publist": "^2.2.4",
    "hexo-prism-plus": "^2.2.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.1.0",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-theme-next": "^8.29.0",
    "katex": "^0.16.0",
    "lodash": "^4.17.21",
    "markdown-it-texmath": "^1.0.0",
    "prism-themes": "^1.8.0",
    "xkcd-api": "^1.2.0"
  },
  "devDependencies": {
    "ava": "^7.0.0",
    "hexo-cli": "^4.3.2",
    "hexo-server": "^3.0.0",
    "jsdom": "^29.1.1"
  }
}
